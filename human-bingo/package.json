{
  "name": "human-bingo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:app\" \"npm run dev:api\"",
    "dev:app": "vite --host 127.0.0.1 --port 4173",
    "dev:api": "vercel dev --listen 3000",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vercel/node": "^23.0.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "concurrently": "^9.1.2",
    "dotenv": "^17.0.1",
    "typescript": "~6.0.2",
    "vercel": "^46.0.0",
    "vite": "^8.3.0",
    "vue-tsc": "^3.3.11"
  }
}
